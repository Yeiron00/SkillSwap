# Copia este archivo a .env y ajusta los valores.

# Cadena de conexión a PostgreSQL.
# Local:            postgresql://usuario:password@localhost:5432/skillswap
# Render/Railway/Neon: usar la cadena que te entrega el proveedor (incluye ?sslmode=require)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/skillswap

# Puerto donde escucha la API
PORT=4000

# Secreto para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET=cambia-este-valor-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=7d

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:8788
